{
  "name": "website-hub-1",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./sites",
    "binding": "ASSETS",
    // Every request goes through src/index.js, so one site can never serve another site's files.
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  // Lets non-production branch builds (`wrangler preview`) succeed. Production deploys ignore it.
  "previews": {},
  // Every subdomain of hazwoperosha.us runs this Worker. The domain must be on Cloudflare.
  "routes": [
    { "pattern": "*.hazwoperosha.us/*", "zone_name": "hazwoperosha.us" }
  ]
}
