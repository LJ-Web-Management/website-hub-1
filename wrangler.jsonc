{
  "name": "website-hub",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./sites",
    "binding": "ASSETS",
    // Every request goes through src/index.js, so one site can never serve another site's files.
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  // Every subdomain of hazwoperosha.com runs this Worker. The domain must be on Cloudflare.
  "routes": [
    { "pattern": "*.hazwoperosha.com/*", "zone_name": "hazwoperosha.com" }
  ]
}
